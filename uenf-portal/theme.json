{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Branco", "color": "#FFFFFF" },
				{ "slug": "superficie", "name": "Superfície", "color": "#F5F7FB" },
				{ "slug": "superficie-2", "name": "Superfície 2", "color": "#EEF1F8" },
				{ "slug": "borda", "name": "Borda", "color": "#E1E6EF" },
				{ "slug": "suave", "name": "Texto suave", "color": "#566176" },
				{ "slug": "contraste", "name": "Texto", "color": "#16203A" },
				{ "slug": "primaria", "name": "Azul UENF", "color": "#1D3771" },
				{ "slug": "marinho", "name": "Azul-marinho", "color": "#12284A" },
				{ "slug": "marinho-900", "name": "Azul-marinho escuro", "color": "#0C1C33" },
				{ "slug": "dourado", "name": "Dourado", "color": "#F2B31B" },
				{ "slug": "dourado-claro", "name": "Dourado claro", "color": "#FDF3D7" }
			],
			"gradients": [
				{ "slug": "marinho", "name": "Azul-marinho", "gradient": "linear-gradient(135deg, #0C1C33 0%, #12284A 55%, #1D3771 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-ext-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Inter", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-italic.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Inter", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-ext-italic.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "mini", "name": "Mini", "size": "0.75rem", "fluid": false },
				{ "slug": "pequeno", "name": "Pequeno", "size": "0.875rem", "fluid": false },
				{ "slug": "medio", "name": "Médio", "size": "1rem", "fluid": false },
				{ "slug": "grande", "name": "Grande", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-grande", "name": "Extra grande", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xx-grande", "name": "Título", "size": "2.25rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "destaque", "name": "Destaque", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.25rem" },
				{ "slug": "20", "name": "2", "size": "0.5rem" },
				{ "slug": "30", "name": "3", "size": "0.75rem" },
				{ "slug": "40", "name": "4", "size": "1rem" },
				{ "slug": "50", "name": "5", "size": "1.5rem" },
				{ "slug": "60", "name": "6", "size": "2rem" },
				{ "slug": "70", "name": "7", "size": "clamp(2.5rem, 5vw, 3.5rem)" },
				{ "slug": "80", "name": "8", "size": "clamp(3rem, 7vw, 5rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "cartao", "name": "Cartão", "shadow": "0 1px 2px rgba(12, 28, 51, 0.04), 0 4px 16px rgba(12, 28, 51, 0.06)" },
				{ "slug": "elevado", "name": "Elevado", "shadow": "0 12px 32px rgba(12, 28, 51, 0.14)" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"custom": {
			"raio": { "p": "8px", "m": "12px", "g": "16px" }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contraste)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medio)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(1rem, 4vw, 2rem)", "right": "clamp(1rem, 4vw, 2rem)", "top": "0", "bottom": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primaria)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--marinho)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.015em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-grande)", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-grande)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--grande)" } },
			"h4": { "typography": { "fontSize": "1.0625rem" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medio)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--primaria)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "8px", "width": "0" },
				"typography": { "fontSize": "var(--wp--preset--font-size--pequeno)", "fontWeight": "600", "lineHeight": "1.2" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--marinho)", "text": "var(--wp--preset--color--base)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--marinho)", "text": "var(--wp--preset--color--base)" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--suave)" }, "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)" } }
		},
		"blocks": {
			"core/post-title": {
				"elements": { "link": { "color": { "text": "inherit" }, "typography": { "textDecoration": "none" }, ":hover": { "color": { "text": "var(--wp--preset--color--primaria)" } } } }
			},
			"core/post-excerpt": { "color": { "text": "var(--wp--preset--color--suave)" }, "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)", "lineHeight": "1.6" } },
			"core/post-date": { "color": { "text": "var(--wp--preset--color--suave)" }, "typography": { "fontSize": "var(--wp--preset--font-size--mini)" } },
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--mini)", "fontWeight": "700", "letterSpacing": "0.08em", "textTransform": "uppercase" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--pequeno)", "fontWeight": "600" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/breadcrumbs": { "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)" }, "color": { "text": "var(--wp--preset--color--suave)" } },
			"core/query-pagination": { "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)", "fontWeight": "600" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--borda)" } },
			"core/quote": { "border": { "left": { "color": "var(--wp--preset--color--dourado)", "width": "4px", "style": "solid" } }, "spacing": { "padding": { "left": "1.25rem" } } },
			"core/table": { "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)" } },
			"core/search": { "typography": { "fontSize": "var(--wp--preset--font-size--pequeno)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabeçalho", "area": "header" },
		{ "name": "footer", "title": "Rodapé", "area": "footer" },
		{ "name": "banners", "title": "Banners rotativos", "area": "uncategorized" },
		{ "name": "barra-lateral", "title": "Barra lateral (Notícias e Editais)", "area": "uncategorized" },
		{ "name": "trilha", "title": "Trilha de navegação", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "largura-total", "title": "Largura total (sem barra lateral)", "postTypes": [ "page", "post" ] },
		{ "name": "pagina-livre", "title": "Página livre (sem título, largura total)", "postTypes": [ "page" ] }
	]
}
